OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_ATTEMPTS=3
OPENAI_TIMEOUT_SECONDS=60
EXTRACTION_MAX_PARAGRAPHS_PER_BLOCK=25
EXTRACTION_MAX_BLOCK_CHARACTERS=20000
APP_OUTPUT_LANGUAGE=de
DATABASE_URL=sqlite:///./data/reading_assistant.db
UPLOAD_TEMP_DIR=/tmp/reading-assistant-uploads
EPUB_MAX_UPLOAD_MB=50
EPUB_MAX_UNCOMPRESSED_MB=250
EPUB_MAX_ARCHIVE_ENTRIES=5000
